<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内升级：下载 APK 后拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 锁屏封面壁纸。SET_WALLPAPER 是 normal 权限（有用户可见文案、非
         signature），装上即有，不需要运行时申请、更不需要 root。
         真机核对：`pm list permissions -f` 里它带 label「设置壁纸」。 -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- 壁纸服务必须常驻后台（听歌时应用不在前台），只能是前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 起前台服务必须声明类型，且类型对应的权限要单独申请。
         少了它在 A14+ 上是**启动即崩**（MissingForegroundServiceTypeException），
         而 A13 上完全正常——见 LockWallpaperService 的注释。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="nudge"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nudge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Nudge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 预设切换的 shortcut 入口。exported 是必须的——shortcut 由系统 launcher
             或三星「模式与日常安排」代为启动。
             excludeFromRecents + noHistory 保证它不出现在最近任务里、不留栈。 -->
        <activity
            android:name=".config.ProfileShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Nudge.Invisible" />

        <!-- 下载好的 APK 在私有目录里，安装器是另一个进程，必须靠 FileProvider
             换成 content:// 才读得到 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Companion 与自动化工具通过指定包名的广播调用，无需前台界面。 -->
        <receiver
            android:name=".action.MediaCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nudge.app.MEDIA" />
            </intent-filter>
        </receiver>

        <!-- 预设切换的广播入口，供 Tasker / Home Assistant / adb 调用，无需前台界面。
             三星「模式与日常安排」不走这里，它直接读上面那个 Activity 的动态 shortcut。 -->
        <receiver
            android:name=".config.ProfileCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nudge.app.PROFILE" />
            </intent-filter>
        </receiver>

        <!-- 锁屏壁纸的 adb 验证入口。这个功能的关键指标（写入耗时、恢复分支、
             熄屏攒住）都没法单测，只能真机验证，而界面点按读不出耗时。 -->
        <receiver
            android:name=".wallpaper.LockWallpaperDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nudge.app.LOCKWP" />
            </intent-filter>
        </receiver>

        <!-- 锁屏封面壁纸。前台服务而非普通后台服务：听歌时 nudge 不在前台，
             One UI 对后台的限制会在几分钟内把普通服务杀掉。

             **必须声明 foregroundServiceType**：Android 14 起不声明就是
             启动即崩。取 specialUse 而不是 mediaPlayback（我们不播放任何
             东西，只是跟着别人的播放状态改壁纸）也不是 dataSync
             （不传输数据）——谎报类型会在上架审核和系统行为上都出问题。 -->
        <service
            android:name=".wallpaper.LockWallpaperService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="跟随播放中的曲目更新锁屏壁纸" />
        </service>

        <service
            android:name=".media.NudgeNotificationListener"
            android:exported="true"
            android:label="nudge"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
